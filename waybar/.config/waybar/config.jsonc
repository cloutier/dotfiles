{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "fixed-center": true,
  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "group/sysmon",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "sort-by": "number",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 10
    },
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true
  },

  "group/sysmon": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/gpu"
    ]
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage:>2}%",
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "RAM {percentage:>2}%",
    "tooltip": true,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "on-click": "kitty -e btop"
  },

  "custom/gpu": {
    "interval": 2,
    "exec-if": "test -r /sys/bus/pci/devices/0000:44:00.0/gpu_busy_percent",
    "exec": "awk '{printf \"%2d%%\\n\", $1}' /sys/bus/pci/devices/0000:44:00.0/gpu_busy_percent",
    "format": "GPU {text}",
    "tooltip-format": "AMD Radeon Navi 21\nGPU load: {text}",
    "on-click": "kitty -e btop"
  },

  "clock": {
    "format": "{:%a %Y-%m-%d %H:%M}"
  },

  "tray": {
    "spacing": 10
  }
}
